      {"key": "approve_board_note", "label": "Record Board Note approval", "from": ["BOARD_NOTE_SUBMITTED"], "to": "BOARD_NOTE_APPROVED", "requires": []},
      {"key": "return_board_note", "label": "Return Board Note for modification", "from": ["BOARD_NOTE_SUBMITTED"], "to": "BOARD_NOTE_DRAFT", "requires": ["comment"]},
